# Production values are NOT edited on the VPS: they live in GitHub
# (Settings -> Environments -> production) and CI writes .env on every deploy.
# Credentials are Secrets, plain config is Variables; when adding a key here,
# also map it in .github/workflows/ci-cd.yml ("Render .env" step).

# Neon Postgres connection string (see docs/specs — §12.9)
DATABASE_URL="postgresql://user:password@host:5432/coinsave?schema=public"

# Postgres on the VPS (docker-compose.prod.yml `db` service). Use a URL-safe
# value (openssl rand -hex 24); prod DATABASE_URL is then
# postgresql://coinsave:<POSTGRES_PASSWORD>@db:5432/coinsave
POSTGRES_PASSWORD=

# Off-site database backups (optional but recommended), any S3-compatible
# storage, e.g. Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PROVIDER=

# Auth (see docs/specs — §5.2)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (see docs/specs — §5.1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (see docs/specs — §5.1, §11.3)
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend (Domains), e.g.
# MAIL_FROM="CoinSave <noreply@your-domain.com>". If unset, falls back to
# onboarding@resend.dev, which only delivers to the Resend account owner.
MAIL_FROM=

# App URLs
FRONTEND_URL="https://app.coinsave.com"
CORS_ORIGIN="https://app.coinsave.com"

# Observability
SENTRY_DSN_BACKEND=

NODE_ENV="development"
