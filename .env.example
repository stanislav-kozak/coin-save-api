# Neon Postgres connection string (see docs/specs — §12.9)
DATABASE_URL="postgresql://user:password@host:5432/coinsave?schema=public"

# Auth (see docs/specs — §5.2)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (see docs/specs — §5.1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (see docs/specs — §5.1, §11.3)
RESEND_API_KEY=

# App URLs
FRONTEND_URL="https://app.coinsave.com"
CORS_ORIGIN="https://app.coinsave.com"

# Observability
SENTRY_DSN_BACKEND=

NODE_ENV="development"
