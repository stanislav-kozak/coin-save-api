<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="700">Upcoming payment reminder</mj-text>
        <mj-text>In 3 days ({{occurrenceDate}}), {{amount}} {{currency}} will be charged from {{walletIcon}} {{walletName}} for your recurring payment {{categoryIcon}} {{recurringName}}.</mj-text>
        <mj-button href="{{{manageUrl}}}">Manage subscriptions</mj-button>
        <mj-text color="#78716C" font-size="13px">To stop this payment, pause the subscription in your recurring transactions list.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
