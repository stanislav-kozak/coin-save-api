<mjml lang="en">
  {{#*inline "title"}}Upcoming payment{{/inline}}
  {{#*inline "preview"}}{{recurringName}}: {{amount}} {{currency}} on {{occurrenceDate}}.{{/inline}}
  {{> head}}
  <mj-body background-color="#FAF7F4" width="560px">
    {{> header}}
    <mj-section background-color="#FFFFFF" border-radius="16px" border="1px solid #EDE7E1" padding="32px 28px 16px 28px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" line-height="1.3">{{categoryIcon}} {{recurringName}} is due in 3 days</mj-text>
        <mj-text>On {{occurrenceDate}}, {{amount}} {{currency}} will be charged from {{walletIcon}} {{walletName}}.</mj-text>
        {{> button url=manageUrl label="Manage recurring payments" fallback="If the button doesn’t work, copy this link into your browser:"}}
        <mj-divider border-width="1px" border-color="#EDE7E1" padding="0 0 16px 0" />
        <mj-text font-size="13px" color="#78716C">Want to skip it? Pause the payment in your recurring payments list.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer-en}}
  </mj-body>
</mjml>
