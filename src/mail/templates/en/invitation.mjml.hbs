<mjml lang="en">
  {{#*inline "title"}}You’re invited{{/inline}}
  {{#*inline "preview"}}{{inviterName}} invited you to {{spaceName}}.{{/inline}}
  {{> head}}
  <mj-body background-color="#FAF7F4" width="560px">
    {{> header}}
    <mj-section background-color="#FFFFFF" border-radius="16px" border="1px solid #EDE7E1" padding="32px 28px 16px 28px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" line-height="1.3">{{inviterName}} invited you to {{spaceName}}</mj-text>
        <mj-text>Join the space on CoinSaveKeeper to see shared wallets and budgets and add expenses together.</mj-text>
        {{> button url=acceptUrl label="Accept invitation" fallback="If the button doesn’t work, copy this link into your browser:"}}
        <mj-text font-size="14px" color="#78716C" padding="0 0 16px 0">This invitation expires in 7 days.</mj-text>
        <mj-divider border-width="1px" border-color="#EDE7E1" padding="0 0 16px 0" />
        <mj-text font-size="13px" color="#78716C">Weren’t expecting this? You can safely ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer-en}}
  </mj-body>
</mjml>
