<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="700">You've been invited to CoinSave</mj-text>
        <mj-text>{{inviterName}} invited you to join the "{{spaceName}}" space on CoinSave.</mj-text>
        <mj-button href="{{{acceptUrl}}}">Accept invitation</mj-button>
        <mj-text color="#78716C" font-size="13px">If you weren't expecting this email, you can safely ignore it.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
