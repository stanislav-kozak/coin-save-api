<mjml lang="en">
  {{#*inline "title"}}Reset your password{{/inline}}
  {{#*inline "preview"}}Choose a new password for your account.{{/inline}}
  {{> head}}
  <mj-body background-color="#FAF7F4" width="560px">
    {{> header}}
    <mj-section background-color="#FFFFFF" border-radius="16px" border="1px solid #EDE7E1" padding="32px 28px 16px 28px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" line-height="1.3">Reset your password</mj-text>
        <mj-text>We received a request to reset the password for your CoinSaveKeeper account. Click the button below to choose a new one.</mj-text>
        {{> button url=resetUrl label="Choose a new password" fallback="If the button doesn’t work, copy this link into your browser:"}}
        <mj-text font-size="14px" color="#78716C" padding="0 0 16px 0">This link expires in 1 hour.</mj-text>
        <mj-divider border-width="1px" border-color="#EDE7E1" padding="0 0 16px 0" />
        <mj-text font-size="13px" color="#78716C">Didn’t ask for this? Ignore this email — your password stays the same.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer-en}}
  </mj-body>
</mjml>
