<mjml lang="uk">
  {{#*inline "title"}}Найближчий платіж{{/inline}}
  {{#*inline "preview"}}{{recurringName}}: {{amount}} {{currency}} — {{occurrenceDate}}.{{/inline}}
  {{> head}}
  <mj-body background-color="#FAF7F4" width="560px">
    {{> header}}
    <mj-section background-color="#FFFFFF" border-radius="16px" border="1px solid #EDE7E1" padding="32px 28px 16px 28px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" line-height="1.3">{{categoryIcon}} {{recurringName}}: платіж через 3 дні</mj-text>
        <mj-text>{{occurrenceDate}} з гаманця {{walletIcon}} {{walletName}} буде списано {{amount}} {{currency}}.</mj-text>
        {{> button url=manageUrl label="Керувати регулярними платежами" fallback="Якщо кнопка не працює, скопіюйте це посилання у браузер:"}}
        <mj-divider border-width="1px" border-color="#EDE7E1" padding="0 0 16px 0" />
        <mj-text font-size="13px" color="#78716C">Хочете пропустити? Поставте платіж на паузу у списку регулярних платежів.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer-uk}}
  </mj-body>
</mjml>
