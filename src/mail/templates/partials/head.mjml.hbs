<mj-head>
    <mj-title>{{> title}}</mj-title>
    <mj-preview>{{> preview}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#1C1917" font-size="16px" line-height="1.6" padding="0 0 16px 0" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light only" />
      <meta name="supported-color-schemes" content="light only" />
    </mj-raw>
    <mj-style>
      :root { color-scheme: light only; supported-color-schemes: light only; }
      .fallback a { color: #F97350; word-break: break-all; }
    </mj-style>
  </mj-head>
