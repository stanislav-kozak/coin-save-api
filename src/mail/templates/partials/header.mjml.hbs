<mj-section padding='32px 0 16px 0'>
  <mj-column>
    <mj-text
      align='center'
      padding='0'
      font-size='22px'
      font-weight='800'
      letter-spacing='-0.3px'
      color='#1C1917'
    >
      <!-- Brand mark served by the frontend; alt is empty because the text
           logo next to it carries the name when images are blocked. -->
      <img
        src='{{{appUrl}}}/apple-icon'
        width='28'
        height='28'
        alt=''
        style='display:inline-block;width:28px;height:28px;border:0;border-radius:8px;vertical-align:middle;'
      />
      <span style='vertical-align:middle;'>&nbsp;CoinSave</span><span
        style='vertical-align:middle;color:#F97350;font-size:13px;font-weight:700;letter-spacing:2px;'
      >&nbsp;KEEPER</span>
    </mj-text>
  </mj-column>
</mj-section>