<mj-button
  href='{{{url}}}'
  align='left'
  background-color='#F97350'
  color='#FFFFFF'
  font-size='16px'
  font-weight='700'
  border-radius='12px'
  inner-padding='14px 28px'
  padding='8px 0 20px 0'
>{{label}}</mj-button>
<mj-text
  css-class='fallback'
  font-size='13px'
  line-height='1.5'
  color='#78716C'
  padding='0 0 16px 0'
>{{fallback}}<br /><a
    href='{{{url}}}'
    style='color:#F97350;word-break:break-all;'
  >{{url}}</a></mj-text>